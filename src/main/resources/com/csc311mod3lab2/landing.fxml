<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root" stylesheets="@landing.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.csc311mod3lab2.HelloController">


    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding>
                <Insets bottom="14" left="28" right="28" top="14" />
            </padding>
            <Label styleClass="nav-brand" text="SUNY Farmingdale" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#signout" styleClass="btn-nav" text="Sign Out" />
        </HBox>
    </top>


    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="24" left="28" right="28" top="20" />
            </padding>


            <VBox spacing="4">
                <Label fx:id="welcomeLabel" styleClass="greeting-title" text="Welcome, Student" />
                <Label styleClass="greeting-sub" text="Computer Science • Fall Semester" />
            </VBox>


            <HBox spacing="16">
                <VBox prefWidth="220" spacing="6" styleClass="stat-card">
                    <Label styleClass="stat-label" text="CUMULATIVE GPA" />
                    <Label styleClass="stat-value" text="3.82" />
                    <Label styleClass="stat-sub" text="Good Standing" />
                </VBox>
            </HBox>


            <VBox spacing="12">
                <Label styleClass="section-heading" text="Class Schedule" />

                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="schedule-card">
                        <Label styleClass="course-badge" text="CSC 311" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
