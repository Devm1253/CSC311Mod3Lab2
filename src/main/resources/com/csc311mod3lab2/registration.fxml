<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18" styleClass="auth-root" stylesheets="@register.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.csc311mod3lab2.HelloController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <VBox alignment="CENTER" spacing="6">
        <Label styleClass="auth-title" text="Create an Account" />
        <Label styleClass="auth-subtitle" />
    </VBox>

    <VBox maxWidth="360" spacing="12">
        <HBox spacing="10">
            <TextField fx:id="firstNameField" promptText="First name" styleClass="text-input" HBox.hgrow="ALWAYS" />
            <TextField fx:id="lastNameField" promptText="Last name" styleClass="text-input" HBox.hgrow="ALWAYS" />
        </HBox>

        <TextField fx:id="emailField" promptText="email" styleClass="text-input" />
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-input" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" styleClass="text-input" />

        <Button maxWidth="Infinity" onAction="#handleCreateAccount" styleClass="btn-primary" text="Create Account" />
    </VBox>
</VBox>
